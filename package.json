{
  "name": "aws-developer-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:backend": "node backend/build.mjs",
    "start:backend": "node backend/dist/server.mjs",
    "typecheck:backend": "tsc -p backend/tsconfig.json",
    "check:secrets": "node scripts/check-sensitive-files.mjs",
    "start:backend:local": "node --env-file=.env.local backend/dist/server.mjs",
    "smoke:live": "node --env-file=.env.local backend/dist/live-smoke.mjs --live-approved",
    "smoke:assistant": "node --env-file=.env.local backend/dist/live-assistant-smoke.mjs --live-approved"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/theme-one-dark": "6.1.3",
    "@xyflow/react": "^12.3.6",
    "ajv": "8.20.0",
    "codemirror": "6.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "4.1.12"
  }
}
