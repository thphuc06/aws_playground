# This file contains no credentials. User enters values privately; never commit .env.local.
PORT=8787
REVIEW_ENABLED=false
OPENAI_API_KEY=
# No reviewer token: anyone able to reach the backend can request reviews.
REVIEW_ALLOWED_ORIGINS=http://localhost:5173
REVIEW_MODEL=gpt-6.1-sol
# No dollar cap. The server limits workflow time, model/tool steps and rate.

# Only for an explicit user-run live smoke; this invokes one paid review.
REVIEW_BACKEND_URL=http://localhost:8787
REVIEW_SMOKE_ORIGIN=http://localhost:5173
